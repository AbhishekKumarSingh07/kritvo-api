# Copy to .env for local development. Never commit real values.
APP_ENV=local
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://kritvo_app:change-me@localhost:5432/kritvo
DATABASE_OWNER_URL=postgresql+asyncpg://kritvo_owner:change-me@localhost:5432/kritvo
DATABASE_SYSTEM_URL=postgresql+asyncpg://kritvo_system:change-me@localhost:5432/kritvo
JWT_SIGNING_KEY_PATH=./secrets/jwt_ed25519.pem
PHONE_HMAC_KEY=change-me
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_FLOW_PRIVATE_KEY_PATH=./secrets/wa_flow_private.pem
S3_BUCKET=kritvo-local
AWS_REGION=ap-south-1
SENTRY_DSN=
