# Copy to .env for local development. Never commit real values.
APP_ENV=local
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://kritvo_app:change-me@localhost:5432/kritvo
DATABASE_OWNER_URL=postgresql+asyncpg://kritvo_owner:change-me@localhost:5432/kritvo
DATABASE_SYSTEM_URL=postgresql+asyncpg://kritvo_system:change-me@localhost:5432/kritvo
# Ed25519 keys, one file per kid: "<kid>.pem" under this directory, JWT_ACTIVE_KID
# signs new tokens. Generate one with:
#   mkdir -p secrets/jwt_keys && openssl genpkey -algorithm ed25519 -out secrets/jwt_keys/dev.pem
# Left empty (the default), local/test generate a throwaway in-memory key instead;
# staging/production refuse to start without a real one here (TASK-003, ADR-0008's
# same fail-closed pattern applied to signing keys).
JWT_SIGNING_KEYS_DIR=./secrets/jwt_keys
JWT_ACTIVE_KID=dev
PHONE_HMAC_KEY=change-me
OTP_HMAC_KEY=change-me
TOTP_ENC_KEY=change-me-32-byte-urlsafe-base64-fernet-key=
NOTIFICATION_SENDER=logging
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_FLOW_PRIVATE_KEY_PATH=./secrets/wa_flow_private.pem
S3_BUCKET=kritvo-local
AWS_REGION=ap-south-1
SENTRY_DSN=
