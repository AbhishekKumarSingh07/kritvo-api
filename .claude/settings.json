{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(scripts/doc-version.sh list *)",
      "Bash(scripts/doc-version.sh show *)",
      "Bash(scripts/doc-version.sh diff *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh api *)",
      "Bash(git tag *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Edit(./docs/architecture/archive/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git reset --hard *)",
      "Bash(git tag -d *)",
      "Bash(git push --delete *)"
    ]
  }
}
